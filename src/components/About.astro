---
import Icon, { type IconName } from './Icon.astro';
import Section from './Section.astro';
import type { Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
const hobbies: { icon: IconName; text: string }[] = [
  { icon: 'book-open', text: t.about.hobbies.reading },
  { icon: 'gamepad', text: t.about.hobbies.gaming },
  { icon: 'server', text: t.about.hobbies.server },
];
---

<Section id="about" title={t.about.title}>
  <div class="prose">
    {t.about.paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </div>
  <h3 class="hobbies-title">{t.about.outside}</h3>
  <ul class="hobbies">
    {hobbies.map((hobby) => (
      <li>
        <Icon name={hobby.icon} size={22} />
        {hobby.text}
      </li>
    ))}
  </ul>
</Section>

<style>
  .prose {
    display: grid;
    gap: var(--space-m);
  }

  .hobbies-title {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-m);
  }

  .hobbies {
    display: grid;
    gap: var(--space-s);
    padding: 0;
    list-style: none;
  }

  .hobbies li {
    display: flex;
    gap: var(--space-s);
    align-items: center;
  }

  .hobbies :global(.icon) {
    flex-shrink: 0;
    color: var(--color-accent);
  }
</style>
