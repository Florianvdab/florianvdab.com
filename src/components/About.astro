---
import Icon, { type IconName } from './Icon.astro';
import Section from './Section.astro';

const hobbies: { icon: IconName; text: string }[] = [
  { icon: 'book-open', text: 'Reading' },
  { icon: 'gamepad', text: 'Gaming' },
  { icon: 'server', text: 'Tinkering with my home server (it serves this site)' },
];
---

<Section id="about" title="About">
  <div class="prose">
    <p>
      I'm a full-stack developer from West Flanders. Since 2021 I've worked on a cloud-based ERP,
      payment terminals and an EV-charging backend, and today I help modernise Belgian federal
      government applications.
    </p>
    <p>
      Most of my work is Java and Spring on the backend with Vue/Nuxt on the front, plus Flutter and
      Android when there's a mobile side to it.
    </p>
  </div>
  <h3 class="hobbies-title">Outside of work</h3>
  <ul class="hobbies">
    {hobbies.map((hobby) => (
      <li>
        <Icon name={hobby.icon} size={22} />
        {hobby.text}
      </li>
    ))}
  </ul>
</Section>

<style>
  .prose {
    display: grid;
    gap: var(--space-m);
  }

  .hobbies-title {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-m);
  }

  .hobbies {
    display: grid;
    gap: var(--space-s);
    padding: 0;
    list-style: none;
  }

  .hobbies li {
    display: flex;
    gap: var(--space-s);
    align-items: center;
  }

  .hobbies :global(.icon) {
    flex-shrink: 0;
    color: var(--color-accent);
  }
</style>
