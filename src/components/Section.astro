---
interface Props {
  id: string;
  title: string;
  /** Wider container for grids (projects, skills). */
  wide?: boolean;
  /** Tinted background band. */
  tinted?: boolean;
}

const { id, title, wide = false, tinted = false } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class:list={['section', { tinted }]}>
  <div class:list={['container', { wide }]}>
    <h2 id={`${id}-title`} class="section-title">
      {title}
    </h2>
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-2xl);
  }

  .tinted {
    background: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  .section-title {
    margin-bottom: var(--space-xl);
  }

  .section-title::after {
    content: '';
    display: block;
    width: 3rem;
    height: 3px;
    margin-top: var(--space-s);
    background: var(--color-accent);
    border-radius: 2px;
  }
</style>
