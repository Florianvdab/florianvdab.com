---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { homePath, htmlLang, locales, type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const other = locales.find((l) => l !== locale)!;

const links = [
  { href: '#about', label: t.nav.about },
  { href: '#experience', label: t.nav.experience },
  { href: '#projects', label: t.nav.projects },
  { href: '#freelance', label: t.nav.freelance },
  { href: '#contact', label: t.nav.contact },
];
---

<header class="site-header">
  <div class="container wide bar">
    <a class="wordmark" href="#top">
      {site.name}
    </a>
    <nav aria-label={t.nav.label}>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="tools">
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        aria-pressed="false"
        title={t.darkMode}
        hidden
      >
        <Icon name="moon" class="when-light" />
        <Icon name="sun" class="when-dark" />
        <span class="visually-hidden">{t.darkMode}</span>
      </button>
      <a
        class="lang"
        href={homePath(other)}
        hreflang={htmlLang[other]}
        lang={htmlLang[other]}
        aria-label={t.switchTo.title}
        title={t.switchTo.title}
      >
        {t.switchTo.label}
      </a>
    </div>
  </div>
</header>

<style>
  /* Mobile: static header, links wrap under the name. No JS, no menu that stays open after a tap. */
  .site-header {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-s);
    padding-block: var(--space-s);
  }

  .wordmark {
    font-family: var(--font-heading);
    /* Shrinks on narrow phones so name + buttons share one row down to 320px. */
    font-size: clamp(1rem, 0.6rem + 2.2vw, 1.5rem);
    font-weight: 700;
    text-decoration: none;
  }

  /* Mobile: name + language switch on the first row, nav links wrap below. */
  nav {
    order: 3;
    flex-basis: 100%;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-block;
    padding-block: var(--space-2xs);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
  }

  /* Theme toggle + language switch: stay together, top right on every screen size. */
  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-left: auto;
  }

  /* Revealed by public/theme.js; the moon shows while light, the sun while dark. */
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    background: none;
    color: var(--color-text);
    border: 1px solid var(--color-text);
    border-radius: var(--radius-s);
    cursor: pointer;
  }

  .theme-toggle[hidden] {
    display: none;
  }

  .theme-toggle:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .theme-toggle[aria-pressed='true'] :global(.when-light),
  .theme-toggle[aria-pressed='false'] :global(.when-dark) {
    display: none;
  }

  .lang {
    padding: var(--space-2xs) var(--space-s);
    border: 1px solid var(--color-text);
    border-radius: var(--radius-s);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .lang:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }

  @media (min-width: 48rem) {
    .bar {
      column-gap: var(--space-l);
    }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: color-mix(in srgb, var(--color-bg) 92%, transparent);
      backdrop-filter: blur(6px);
    }

    nav {
      order: 0;
      flex-basis: auto;
      margin-left: auto;
    }

    .tools {
      margin-left: 0;
    }

    nav a {
      font-size: var(--step-0);
    }
  }
</style>
