---
import Icon from './Icon.astro';
import Section from './Section.astro';
import { site } from '../data/site';
import type { Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

<Section id="contact" title={t.contact.title} tinted>
  <p class="intro">{t.contact.intro}</p>
  <ul class="channels">
    <li>
      <a href={`mailto:${site.email}`}>
        <Icon name="mail" />
        {site.email}
      </a>
    </li>
    <li>
      <a href={site.social.github}>
        <Icon name="github" />
        github.com/{site.handle}
      </a>
    </li>
    <li>
      <a href={site.social.linkedin}>
        <Icon name="linkedin" />
        LinkedIn
      </a>
    </li>
    <li>
      <a href={site.cv.href} download>
        <Icon name="download" />
        {t.contact.downloadCv} <span class="meta">(PDF, {site.cv.size})</span>
      </a>
    </li>
  </ul>
</Section>

<style>
  .intro {
    margin-bottom: var(--space-l);
  }

  .channels {
    display: grid;
    gap: var(--space-m);
    padding: 0;
    list-style: none;
  }

  .channels a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-s);
    font-size: var(--step-1);
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .meta {
    font-size: var(--step--1);
    font-weight: 400;
  }

  .channels :global(.icon) {
    flex-shrink: 0;
    color: var(--color-accent);
  }
</style>
