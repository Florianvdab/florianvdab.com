---
import Icon from './Icon.astro';
import Section from './Section.astro';
import { site } from '../data/site';
---

<Section id="contact" title="Get in touch" tinted>
  <p class="intro">The quickest way to reach me is email. I'm also on GitHub and LinkedIn.</p>
  <ul class="channels">
    <li>
      <a href={`mailto:${site.email}`}>
        <Icon name="mail" />
        {site.email}
      </a>
    </li>
    <li>
      <a href={site.social.github}>
        <Icon name="github" />
        github.com/{site.handle}
      </a>
    </li>
    <li>
      <a href={site.social.linkedin}>
        <Icon name="linkedin" />
        LinkedIn
      </a>
    </li>
  </ul>
</Section>

<style>
  .intro {
    margin-bottom: var(--space-l);
  }

  .channels {
    display: grid;
    gap: var(--space-m);
    padding: 0;
    list-style: none;
  }

  .channels a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-s);
    font-size: var(--step-1);
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .channels :global(.icon) {
    flex-shrink: 0;
    color: var(--color-accent);
  }
</style>
