---
import Icon, { type IconName } from './Icon.astro';
import Section from './Section.astro';
import { site } from '../data/site';

const points: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'zap',
    title: 'Fast & SEO-friendly',
    text: 'Static pages load almost instantly and are easy for search engines to read.',
  },
  {
    icon: 'wallet',
    title: 'Cheap to host',
    text: 'No server-side code or database to run, so hosting costs little or nothing.',
  },
  {
    icon: 'key',
    title: 'You own everything',
    text: 'The code, the content and the domain are yours. No lock-in to a site builder.',
  },
];

const mail = `mailto:${site.email}?subject=${encodeURIComponent('Website project')}`;
---

<Section id="freelance" title="Need a website?">
  <p class="intro">
    In my free time I build fast, affordable static websites for small businesses, portfolios and
    event or landing pages.
  </p>
  <ul class="points">
    {points.map((point) => (
      <li>
        <Icon name={point.icon} size={28} />
        <div>
          <h3>{point.title}</h3>
          <p>{point.text}</p>
        </div>
      </li>
    ))}
  </ul>
  <a class="button" href={mail}>
    <Icon name="mail" />
    Tell me about your project
  </a>
</Section>

<style>
  .intro {
    max-width: 60ch;
    font-size: var(--step-1);
  }

  .points {
    display: grid;
    gap: var(--space-l);
    margin-block: var(--space-xl);
    padding: 0;
    list-style: none;
  }

  .points li {
    display: flex;
    gap: var(--space-m);
    align-items: flex-start;
  }

  .points :global(.icon) {
    flex-shrink: 0;
    color: var(--color-accent);
  }

  h3 {
    margin-bottom: var(--space-2xs);
    font-size: var(--step-0);
    font-family: var(--font-body);
    font-weight: 700;
  }
</style>
