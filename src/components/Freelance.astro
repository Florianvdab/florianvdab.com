---
import Icon, { type IconName } from './Icon.astro';
import Section from './Section.astro';
import { site } from '../data/site';
import type { Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
const { points } = t.freelance;
const items: { icon: IconName; title: string; text: string }[] = [
  { icon: 'zap', ...points.fast },
  { icon: 'wallet', ...points.cheap },
  { icon: 'key', ...points.yours },
];
const mail = `mailto:${site.email}?subject=${encodeURIComponent(t.freelance.mailSubject)}`;
---

<Section id="freelance" title={t.freelance.title}>
  <p class="intro">{t.freelance.intro}</p>
  <ul class="points">
    {items.map((point) => (
      <li>
        <Icon name={point.icon} size={28} />
        <div>
          <h3>{point.title}</h3>
          <p>{point.text}</p>
        </div>
      </li>
    ))}
  </ul>
  <a class="button" href={mail}>
    <Icon name="mail" />
    {t.freelance.cta}
  </a>
</Section>

<style>
  .intro {
    max-width: 60ch;
    font-size: var(--step-1);
  }

  .points {
    display: grid;
    gap: var(--space-l);
    margin-block: var(--space-xl);
    padding: 0;
    list-style: none;
  }

  .points li {
    display: flex;
    gap: var(--space-m);
    align-items: flex-start;
  }

  .points :global(.icon) {
    flex-shrink: 0;
    color: var(--color-accent);
  }

  h3 {
    margin-bottom: var(--space-2xs);
    font-size: var(--step-0);
    font-family: var(--font-body);
    font-weight: 700;
  }
</style>
