---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import profilePicture from '../assets/profile-picture.jpg';
import { site } from '../data/site';
import type { Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

<div class="hero container wide">
  <div class="text">
    <p class="location">
      <Icon name="map-pin" size={18} />
      {t.location}
    </p>
    <h1>{t.hero.greeting}</h1>
    <p class="lede">{t.tagline}</p>
    <div class="actions">
      <a class="button" href="#projects">
        {t.hero.seeWork}
      </a>
      <a class="button secondary" href="#freelance">
        {t.hero.hire}
      </a>
    </div>
    <ul class="social">
      <li>
        <a href={site.social.github}>
          <Icon name="github" />
          GitHub
        </a>
      </li>
      <li>
        <a href={site.social.linkedin}>
          <Icon name="linkedin" />
          LinkedIn
        </a>
      </li>
      <li>
        <a href={site.cv.href} download>
          <Icon name="download" />
          {t.hero.downloadCv} <span class="meta">(PDF, {site.cv.size})</span>
        </a>
      </li>
    </ul>
  </div>
  <Picture
    src={profilePicture}
    alt={t.hero.portraitAlt}
    formats={['avif', 'webp']}
    widths={[160, 320, 480, 640]}
    sizes="(min-width: 48rem) 320px, 160px"
    loading="eager"
    fetchpriority="high"
    class="portrait"
  />
</div>

<style>
  .hero {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
    padding-block: var(--space-2xl);
  }

  /* Mobile: portrait above the text. */
  .hero :global(picture) {
    order: -1;
  }

  .hero :global(.portrait) {
    width: 160px;
    height: 160px;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid var(--color-bg);
    outline: 2px solid var(--sage);
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: 1fr auto;
      gap: var(--space-2xl);
    }

    .hero :global(picture) {
      order: 0;
    }

    .hero :global(.portrait) {
      width: 320px;
      height: 320px;
    }
  }

  .text {
    display: grid;
    gap: var(--space-l);
  }

  .location {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .location :global(.icon) {
    color: var(--color-accent);
  }

  .lede {
    max-width: 44ch;
    font-size: var(--step-1);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-l);
    padding: 0;
    list-style: none;
  }

  .social a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-weight: 500;
  }

  .meta {
    font-weight: 400;
    font-size: var(--step--1);
  }
</style>
