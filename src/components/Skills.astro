---
import Section from './Section.astro';
import type { Locale } from '../i18n/locales';
import { skillGroups, tr, useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Section id="skills" title={t.skills.title} wide>
  <div class="groups">
    {skillGroups.map((group) => {
      const id = `skills-${group.name.en.toLowerCase().replace(/[^a-z]+/g, '-')}`;
      return (
        <div class="group">
          <h3 id={id}>{tr(group.name, locale)}</h3>
          <ul class="chips" aria-labelledby={id}>
            {group.skills.map((skill) => (
              <li>{tr(skill, locale)}</li>
            ))}
          </ul>
        </div>
      );
    })}
  </div>
</Section>

<style>
  .groups {
    display: grid;
    gap: var(--space-xl) var(--space-l);
  }

  @media (min-width: 48rem) {
    .groups {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .groups {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  h3 {
    margin-bottom: var(--space-s);
  }
</style>
