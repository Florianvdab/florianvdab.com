---
// One 404 for every URL (nginx serves it), so it speaks both languages: Dutch first, as the default.
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base
  locale="nl"
  title={`Pagina niet gevonden · ${site.name}`}
  description="Deze pagina bestaat niet."
  noindex
>
  <main id="main" class="container not-found">
    <a class="wordmark" href="/">
      {site.name}
    </a>
    <p class="code" aria-hidden="true">
      404
    </p>
    <h1>Deze pagina bestaat niet.</h1>
    <p>
      Misschien is ze verhuisd, of zit er een typfout in de link. Alles wat de moeite waard is, vind
      je op de homepagina.
    </p>
    <p lang="en">
      This page doesn't exist. It may have moved, or the link has a typo. Everything worth seeing is
      on the home page.
    </p>
    <div class="actions">
      <a class="button" href="/nl/">
        Naar de homepagina
      </a>
      <a class="button secondary" href="/en/" lang="en">
        Back to the home page
      </a>
    </div>
  </main>
</Base>

<style>
  .not-found {
    display: grid;
    gap: var(--space-l);
    justify-items: start;
    align-content: center;
    min-height: 100svh;
    padding-block: var(--space-2xl);
  }

  .wordmark {
    font-family: var(--font-heading);
    font-size: var(--step-1);
    font-weight: 700;
    text-decoration: none;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .code {
    font-family: var(--font-heading);
    font-size: clamp(5rem, 3rem + 10vw, 9rem);
    font-weight: 700;
    line-height: 1;
    color: var(--color-accent);
  }
</style>
