---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base>
  <main id="main" class="container placeholder">
    <p class="eyebrow">{site.location}</p>
    <h1>Hi, I'm Florian.</h1>
    <p class="lede">
      Full-stack developer (Java/Spring, Vue/Nuxt, Flutter) building reliable software for
      government, payments and ERP.
    </p>
    <p>This site is under construction. Meanwhile:</p>
    <ul class="links">
      <li>
        <a href={site.social.github}>GitHub</a>
      </li>
      <li>
        <a href={site.social.linkedin}>LinkedIn</a>
      </li>
      <li>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </li>
    </ul>
  </main>
</Base>

<style>
  .placeholder {
    display: grid;
    gap: var(--space-l);
    padding-block: var(--space-2xl);
  }

  .eyebrow {
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    padding-bottom: var(--space-s);
    border-bottom: 3px solid var(--color-accent);
    justify-self: start;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-l);
    padding: 0;
    list-style: none;
  }

  .lede {
    font-size: var(--step-1);
    max-width: 50ch;
  }
</style>
